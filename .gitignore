# ---- Terraform ----
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# ---- SSH keys / secrets ----
*.pem
*.key
*.pub
id_rsa*
credentials
.env
.env.*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- Benchmark results ----
# Ignore stray/local result files, but DO commit the real published charts + JSON
# from the live Tesla T4 run so they render in the README on GitHub.
results/*.json
results/*.png
!results/.gitkeep
!results/matmul.png
!results/cnn_training.png
!results/speedup.png
!results/matmul.json
!results/cnn_training.json

# ---- SSM run artifacts (throwaway command ids / raw dumps) ----
scripts/dump_raw.txt
scripts/dump_cmd.txt
scripts/last_cmd.txt

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
*.swp
